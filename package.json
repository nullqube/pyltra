{
    "name": "pyltra",
    "version": "2.0.0",
    "description": "A static site generator for multilingual projects.",
    "type": "module",
    "scripts": {
        "dev": "tsx watch ./src/bin/cli.ts",
        "build": "tsx ./src/bin/cli.ts build",
        "start": "tsx ./src/bin/cli.ts serve",
        "typecheck": "tsc --noEmit",
        "bundle": "node ./scripts/build.mjs",
        "prepublishOnly": "node ./scripts/build.mjs"
    },
    "bin": {
        "pyltra": "./dist/bin/cli.js"
    },
    "exports": {
        ".": "./dist/index.js",
        "./types": "./dist/types/index.d.ts"
    },
    "files": [
        "dist",
        "templates",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "dependencies": {
        "autoprefixer": "^10.4.27",
        "browser-sync": "^3.0.2",
        "chalk": "^5.6.2",
        "chokidar": "^3.6.0",
        "commander": "^13.1.0",
        "cssnano": "^7.1.2",
        "date-fns": "^4.1.0",
        "fs-extra": "^11.3.4",
        "gray-matter": "^4.0.3",
        "html-minifier": "^4.0.0",
        "js-yaml": "^4.1.0",
        "markdown-it": "^14.1.1",
        "marked": "^15.0.8",
        "minimist": "^1.2.8",
        "nunjucks": "^3.2.4",
        "ora": "^9.4.0",
        "postcss": "^8.5.8",
        "prompts": "^2.4.2",
        "sass": "^1.86.0",
        "sharp": "^0.34.5",
        "sirv": "^3.0.2",
        "slugify": "^1.6.6",
        "svgo": "^2.8.0",
        "yaml": "^2.8.2",
        "zod": "^4.3.6"
    },
    "keywords": [
        "static-site-generator",
        "build-tool"
    ],
    "author": "nullqube",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nullqube/pyltra.git"
    },
    "bugs": {
        "url": "https://github.com/nullqube/pyltra/issues"
    },
    "homepage": "https://github.com/nullqube/pyltra#readme",
    "devDependencies": {
        "@types/node": "^26.0.1",
        "nodemon": "^3.1.14",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "esbuild": "^0.27.3",
        "fast-glob": "^3.3.3"
    }
}
